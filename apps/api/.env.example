# --- Server ---
PORT=4000
NODE_ENV=development
# Optional: trace | debug | info | warn | error | fatal | silent
# LOG_LEVEL=info

# --- Database (PostgreSQL) ---
# Example: postgresql://syncspace:syncspace@localhost:5432/syncspace?schema=public
# Required for everything except /health; required at boot in production.
DATABASE_URL=

# Optional: an external, migrated database for the API test suite. When unset,
# tests start an embedded PostgreSQL (PGlite) automatically.
# TEST_DATABASE_URL=

# --- Public URLs ---
# Web app (links in emails, OAuth redirects back to the app). Required in production.
FRONTEND_URL=http://localhost:5173
# This API (OAuth callback URLs: <API_PUBLIC_URL>/auth/oauth/<provider>/callback). Required in production.
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed browser origins (credentials are enabled).
CORS_ORIGIN=http://localhost:5173

# --- Sessions ---
# Required in production: at least 32 random characters, e.g. `openssl rand -base64 48`.
# In development an insecure fallback is used when empty.
JWT_SECRET=
# lax (default) | strict | none. "none" requires HTTPS (production only). See docs/AUTH.md.
# COOKIE_SAME_SITE=lax
# Optional cookie domain to share the session across subdomains, e.g. .syncspace.dev
# COOKIE_DOMAIN=

# --- Social sign-in (optional; a provider is enabled when both values are set) ---
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:4000/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers (OAuth App)
#   Authorization callback URL: http://localhost:4000/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (optional in development) ---
# Without SMTP_HOST, development captures emails in memory: open http://localhost:4000/dev/mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SyncSpace <no-reply@syncspace.local>

# --- Attachments (file uploads) ---
# local     development only: files under LOCAL_STORAGE_DIR, served by the API after access checks
# s3        any S3-compatible object storage (Cloudflare R2 recommended, AWS S3, Backblaze B2, MinIO)
# disabled  uploads off (text chat and tasks keep working)
# Production refuses "local": a hosted container's disk is not durable. See docs/UPLOADS.md.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.uploads
# Required when STORAGE_DRIVER=s3. The bucket must be PRIVATE (downloads use short-lived signed URLs).
S3_BUCKET=
# "auto" for Cloudflare R2; the bucket's region for AWS S3 (e.g. eu-central-1).
S3_REGION=auto
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com  (leave empty for AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and some self-hosted providers
S3_FORCE_PATH_STYLE=false
# Lifetime of signed download URLs (seconds, 30–3600)
UPLOAD_URL_TTL_SECONDS=300
