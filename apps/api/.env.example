# --- Server ---
PORT=4000
NODE_ENV=development
# Optional: trace | debug | info | warn | error | fatal | silent
# LOG_LEVEL=info

# --- Database (PostgreSQL) ---
# Example: postgresql://syncspace:syncspace@localhost:5432/syncspace?schema=public
# Optional in development (only /health/ready and DB-backed routes need it); required in production.
DATABASE_URL=

# Optional: a separate, migrated database for the database invariant tests
# (apps/api/src/db/*.db.test.ts). Those tests are skipped when this is unset.
# TEST_DATABASE_URL=

# --- Web client ---
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed browser origins (credentials are enabled).
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
# Required in production: at least 32 random characters, e.g. `openssl rand -base64 48`.
# In development an insecure fallback is used when empty.
JWT_SECRET=
